# Copy this file to .env and fill in your own values.
# NEVER put real passwords or secrets in this file. It is committed to Git.

# --- Required ---
# MongoDB Atlas connection string
MONGO_URI=your_mongodb_connection_string_here
# Long random text used to sign login tokens (make your own, at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret

# --- Optional ---
# Server port (default 5000)
PORT=5000
# Only when the app runs behind a hosting proxy (for example 1). Leave unset locally.
TRUST_PROXY=
# Address of a deployed frontend, added to the CORS allowed list
FRONTEND_URL=

# --- Email reminders (reminders start only if EMAIL_USER is set) ---
# For testing, create a free fake inbox at https://ethereal.email
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_smtp_username_here
EMAIL_PASS=your_smtp_password_here
# Sender shown in emails (default: Job Tracker <EMAIL_USER>)
EMAIL_FROM=